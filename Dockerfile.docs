# Builds the Safe-ICE documentation site and serves it with live reload.
#
#   docker build -f Dockerfile.docs -t safe-ice-docs .
#   docker run --rm -p 8000:8000 safe-ice-docs

FROM python:3.12-slim

WORKDIR /workspace

# The docs dependency group is declared in pyproject.toml, which pip >= 25.1
# reads directly.
COPY pyproject.toml /workspace/
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --group docs

# mkdocstrings reads the package from the source tree and the changelog page
# includes CHANGELOG.md, so both are needed alongside docs/.
COPY mkdocs.yml CHANGELOG.md /workspace/
COPY docs /workspace/docs
COPY safe_ice /workspace/safe_ice

# Fail the image build, rather than the first request, if the site is broken.
RUN mkdocs build --strict

EXPOSE 8000

CMD ["mkdocs", "serve", "--dev-addr", "0.0.0.0:8000"]

# Builds and serves the Safe-ICE documentation.
#
#   docker build -f Dockerfile.docs -t safe-ice-docs .
#   docker run --rm -p 8000:8000 safe-ice-docs

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    make \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY docs/requirements.txt /tmp/docs-requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /tmp/docs-requirements.txt

# Package metadata lives entirely in pyproject.toml.
COPY pyproject.toml README.md LICENSE /workspace/
COPY safe_ice /workspace/safe_ice
RUN pip install --no-cache-dir -e .

COPY docs /workspace/docs

WORKDIR /workspace/docs
RUN make clean && make html

EXPOSE 8000

CMD ["python", "-m", "http.server", "8000", "--directory", "build/html"]

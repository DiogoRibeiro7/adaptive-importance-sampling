# Jupyter Lab image with Safe-ICE preinstalled.
#
#   docker build -f Dockerfile.jupyter -t safe-ice-jupyter .
#   docker run --rm -p 8888:8888 safe-ice-jupyter

# The jupyter/* images on Docker Hub are no longer updated; quay.io is the
# maintained home for the Jupyter Docker Stacks.
FROM quay.io/jupyter/scipy-notebook:latest

USER ${NB_UID}

WORKDIR /tmp/safe-ice
COPY --chown=${NB_UID}:${NB_GID} pyproject.toml README.md LICENSE ./
COPY --chown=${NB_UID}:${NB_GID} safe_ice ./safe_ice

# JupyterLab 4 ships prebuilt extensions as ordinary pip packages, so there is
# no `jupyter labextension install` step any more.
RUN pip install --no-cache-dir ".[all]" \
    && pip install --no-cache-dir \
        jupyterlab-execute-time \
        jupyterlab-git \
        ipywidgets \
    && jupyter lab clean \
    && fix-permissions "${CONDA_DIR}" \
    && fix-permissions "/home/${NB_USER}"

WORKDIR /home/jovyan/work

COPY --chown=${NB_UID}:${NB_GID} examples /home/jovyan/work/examples

CMD ["start-notebook.py", "--LabApp.default_url=/lab/tree/examples"]
